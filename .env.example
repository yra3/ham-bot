# Upstream configuration
SUB_URL=https://example.com/subscription
HWID=00000000-0000-0000-0000-000000000000

# Cache and checks
CACHE_TTL_HOURS=24
CHECK_SCHEDULE_CRON=0 1 * * *
TARGET_ALIVE_NODES=5
REGION_WHITELIST=["Финляндия", "Нидерланды"]
# Domains routed directly (comma-separated JSON list, e.g. ["example.com", "chat.example.com"])
DIRECT_DOMAINS=[]

# Web server / Subscription endpoint
# Optional full base URL with protocol and port (overrides SUB_SCHEME + SUB_DOMAIN), e.g. http://203.0.113.10:8088
SUB_BASE_URL=
SUB_SCHEME=https
SUB_DOMAIN=sub.example.com
HOST_PORT=8088
PORT=8080
SUB_SECRET_TOKEN=change-me-secret-token

# Bot platform toggles
ENABLE_MATRIX_BOT=true
ENABLE_TELEGRAM_BOT=false

# Matrix Bot configuration
MATRIX_HOMESERVER=https://matrix.example.com
MATRIX_USER_ID=@ham-bot:example.com
MATRIX_ACCESS_TOKEN=your-matrix-access-token
MATRIX_ADMIN_USERS=["@admin:example.com"]

# Telegram Bot configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USERS=[]
TELEGRAM_PROXY_URL=
# Bind address for optional xray sidecar SOCKS5 port (default localhost only)
PROXY_BIND_HOST=127.0.0.1

# Admin contacts shown once to uninvited Telegram users
ADMIN_CONTACT_TG=
ADMIN_CONTACT_MATRIX=
